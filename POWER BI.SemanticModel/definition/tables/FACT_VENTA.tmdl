	column hora
		dataType: dateTime
		isHidden
		formatString: Long Time
		lineageTag: 2c1aaba4-ee9a-4e84-b0fd-63a93b59388f
		summarizeBy: none
		sourceColumn: hora

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Time

	column 'Franja Horaria' = FORMAT ( HOUR ( FACT_VENTA[hora] ), "00" ) & ":00"
		dataType: string
		lineageTag: 8526d81f-0b98-4b4a-8be7-d9cd9baf417a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Turno = SWITCH ( TRUE (), HOUR ( FACT_VENTA[hora] ) < 16, "Almuerzo (12-15)", HOUR ( FACT_VENTA[hora] ) < 19, "Tarde (16-18)", "Noche (19-21)" )
		dataType: string
		lineageTag: b5db05a2-9cf4-4b42-b024-9d27910b8964
		summarizeBy: none
		sortByColumn: 'Turno Orden'

		annotation SummarizationSetBy = Automatic

	column 'Turno Orden' = SWITCH ( TRUE (), HOUR ( FACT_VENTA[hora] ) < 16, 1, HOUR ( FACT_VENTA[hora] ) < 19, 2, 3 )
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 77c430e6-ec7f-442f-a6fc-524f23f4b442
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column id_producto
		dataType: string
		lineageTag: c651d4da-d2b6-41f8-9516-7e05546802d1
		summarizeBy: none
		sourceColumn: id_producto

		annotation SummarizationSetBy = Automatic

